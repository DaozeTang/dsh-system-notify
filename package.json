{
  "name": "dsh-system-notify",
  "version": "0.4.0",
  "description": "System notifications for DeepSeek Harness when a conversation finishes, waits for approval or authorization, or fails.",
  "type": "module",
  "license": "MIT",
  "author": "DaozeTang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaozeTang/dsh-system-notify.git"
  },
  "homepage": "https://github.com/DaozeTang/dsh-system-notify#readme",
  "bugs": {
    "url": "https://github.com/DaozeTang/dsh-system-notify/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notifications",
    "approval",
    "desktop",
    "macos"
  ],
  "engines": {
    "node": ">=24.22.3",
    "dsh": "^0.2.3-alpha.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/host-check.mjs test/host-apply.mjs test/client-load.mjs test/session-gate.mjs",
    "test:host": "node --test test/host-check.mjs test/host-apply.mjs",
    "test:client": "node --test test/client-load.mjs",
    "check": "node --check index.js && node --check client.js",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check && npm test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
